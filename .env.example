# Variables de entorno para PushOps.
# Copia este fichero a .env y rellena los valores.

# Base de datos Turso (o una ruta local para desarrollo)
TURSO_DATABASE_URL=libsql://pushops-<tu-org>.turso.io
TURSO_AUTH_TOKEN=

# Firma de las sesiones (mín. 16 caracteres, usa openssl rand -hex 32)
JWT_SECRET=

# Token del bot de Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=

# URL pública del servidor
PUBLIC_URL=https://pushops.ejemplo.com

# Puerto de escucha
PORT=8080

# CORS: * por defecto
ALLOW_ORIGINS=*

# Solo en desarrollo: habilita /api/auth/dev
DEV_MODE=false
